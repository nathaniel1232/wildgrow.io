# ----------------------------------------------------------------------------
# Wildgrow — environment
# Copy to .env and fill in. The app runs fully on defaults (no keys required).
# ----------------------------------------------------------------------------

# Database. The app currently runs on SQLite (zero-setup local dev):
DATABASE_URL="file:./prisma/dev.db"
# When migrating to Supabase Postgres (see SUPABASE_MIGRATION.md), point this at
# the pooled connection string instead, e.g.:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ----------------------------------------------------------------------------
# Supabase — DB layer (Prisma → Supabase Postgres). The publishable (anon) key
# is safe to expose to the browser. The DB connection string goes in
# DATABASE_URL above; the flip is documented in SUPABASE_MIGRATION.md.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret used to sign session cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# ----------------------------------------------------------------------------
# AI (optional) — the app works without any key via the built-in engine.
# Add ONE of the following to switch to live generation. Auto-detected.
# ----------------------------------------------------------------------------

# Option A — Anthropic (Claude): best quality.
# ANTHROPIC_API_KEY="sk-ant-..."

# Option B — MiniMax (cheap, great value) via its Anthropic-compatible endpoint.
# This reuses the Anthropic path (reliable tool-calling). Recommended for MiniMax.
# ANTHROPIC_API_KEY="your-minimax-key"
# ANTHROPIC_BASE_URL="https://api.minimax.io/anthropic"
# WILDFIRE_AI_MODEL="MiniMax-M2.5"

# Option C — any other OpenAI-compatible API (OpenAI, DeepSeek, Together, Groq…).
# OPENAI_API_KEY="..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# WILDFIRE_AI_MODEL="gpt-4o-mini"

# Option D — Gemini via Vertex AI (Google Cloud). Good for spending Cloud credits,
# or where the AI Studio / generativelanguage API is geo-blocked. Auth uses
# Application Default Credentials — no API key. Run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
# WILDFIRE_AI_PROVIDER="gemini"
# GOOGLE_VERTEX_PROJECT="your-gcp-project-id"
# GOOGLE_VERTEX_LOCATION="global"
# WILDFIRE_AI_MODEL="gemini-2.5-flash"

# Optional: force a provider (otherwise auto-detected from whichever key is set):
# WILDFIRE_AI_PROVIDER="anthropic"   # or "openai" or "gemini"

# ----------------------------------------------------------------------------
# Niche Radar data (optional) — "demo" (default) shows sample data.
# Set "ensemble" + a token to pull live TikTok videos that play in-app.
# ----------------------------------------------------------------------------
SOCIAL_PROVIDER="demo"
# ENSEMBLE_TOKEN="..."

# ----------------------------------------------------------------------------
# Billing — Stripe (optional). With NO keys, billing runs in honest demo mode:
# picking a plan unlocks the app without a charge (the demo account works with
# zero keys). Set the keys below to switch on real subscription checkout.
# ----------------------------------------------------------------------------
# Secret API key (sk_test_... in test mode). Presence of this enables billing.
# STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret from `stripe listen` or the Dashboard webhook config.
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring Price IDs (NOT product IDs) for each plan, created in Stripe.
# STRIPE_PRICE_WILDFIRE="price_..."   # $29/mo plan
# STRIPE_PRICE_STUDIO="price_..."     # $79/mo plan
# Free-trial length in days for new subscriptions (default 7; set 0 to disable).
# STRIPE_TRIAL_DAYS="7"

# Public base URL used for Stripe Checkout success/cancel redirects and email
# links. Optional locally (the request origin is used); set it in production.
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ----------------------------------------------------------------------------
# Email verification (optional, off by default). When enabled AND a provider is
# configured, new signups are emailed a verification link. With no provider it
# NEVER blocks signup — the link is logged to the server console instead.
# ----------------------------------------------------------------------------
# REQUIRE_EMAIL_VERIFICATION="false"
# Provider: Resend. Presence of the key enables real sending.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Wildgrow <onboarding@resend.dev>"
